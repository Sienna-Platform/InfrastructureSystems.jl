{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model_type",
    "system_uuid",
    "base_power",
    "supports_realized_values_post_calculation",
    "settings",
    "axes",
    "datasets"
  ],
  "additionalProperties": false,
  "properties": {
    "model_type": {
      "$ref": "common.json#/$defs/ModelType"
    },
    "system_uuid": {
      "$ref": "common.json#/$defs/Uuid"
    },
    "base_power": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "supports_realized_values_post_calculation": {
      "type": "boolean",
      "description": "True when PowerAnalytics can join the datasets of the model across executions into one time axis. The join keeps the first interval/resolution horizon steps of each execution. A model with a time axis sets it to false."
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "Axis.json"
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "Dataset.json"
      }
    },
    "tables": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "Table.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "supports_realized_values_post_calculation": {
            "const": true
          }
        },
        "required": [
          "supports_realized_values_post_calculation"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "required": [
              "execution",
              "horizon"
            ],
            "propertyNames": {
              "not": {
                "const": "time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "axes"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "properties": {
              "execution": {
                "$ref": "Axis.json#/$defs/ExecutionAxis"
              },
              "horizon": {
                "$ref": "Axis.json#/$defs/HorizonAxis"
              }
            }
          }
        }
      }
    }
  ]
}
