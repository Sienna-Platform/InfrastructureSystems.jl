{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "container",
    "entry_type",
    "meta",
    "axes",
    "dtype",
    "fill_value",
    "quantity_kind",
    "unit_system",
    "units",
    "layout",
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "container": {
      "$ref": "common.json#/$defs/Container",
      "description": "Store container that holds the entry."
    },
    "entry_type": {
      "$ref": "common.json#/$defs/TypeName",
      "description": "Name of the entry type, for example ActivePowerVariable."
    },
    "component_type": {
      "$ref": "common.json#/$defs/TypeName",
      "description": "Name of the component type. The entry has no component type when this field is absent."
    },
    "meta": {
      "$ref": "common.json#/$defs/Meta",
      "description": "Optional entry label that separates entries with the same entry type and component type. It is empty when absent."
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Axis names, in the storage order of the array dimensions. The writer sets the order. For a time, execution, or horizon axis the name is the kind. For a component axis it is the component_type values joined with two underscores, plus two underscores and the subset value if present. For a label axis it is the name field."
    },
    "dtype": {
      "$ref": "common.json#/$defs/Dtype",
      "description": "Element type of the array."
    },
    "fill_value": {
      "description": "Value of the array cells that no solve wrote. It must match dtype: f64 and f32 take a number or \"NaN\"; i64 and i32 take an integer; bool takes a boolean."
    },
    "quantity_kind": {
      "$ref": "common.json#/$defs/QuantityKind",
      "description": "Kind of the physical quantity. The name comes from the shared quantity registry."
    },
    "unit_system": {
      "$ref": "common.json#/$defs/UnitSystem",
      "description": "Unit system of the values."
    },
    "base_reference": {
      "$ref": "common.json#/$defs/BaseReference",
      "description": "Base of a COMPONENT_BASE value. It is absent for NATURAL_UNITS."
    },
    "units": {
      "type": "string",
      "minLength": 1,
      "description": "Unit of the values. It is pu for COMPONENT_BASE."
    },
    "layout": {
      "$ref": "#/$defs/DatasetLayout",
      "description": "HDF5 chunking and filters of the array, as written."
    },
    "path": {
      "type": "string",
      "pattern": "^/[^/]+/datasets/[^/]+$",
      "description": "HDF5 path of the array."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "unit_system": {
            "const": "COMPONENT_BASE"
          }
        },
        "required": [
          "unit_system"
        ]
      },
      "then": {
        "required": [
          "base_reference"
        ],
        "properties": {
          "units": {
            "const": "pu"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "base_reference"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "dtype": {
            "enum": [
              "f64",
              "f32"
            ]
          }
        },
        "required": [
          "dtype"
        ]
      },
      "then": {
        "properties": {
          "fill_value": {
            "anyOf": [
              {
                "const": "NaN"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dtype": {
            "enum": [
              "i64",
              "i32"
            ]
          }
        },
        "required": [
          "dtype"
        ]
      },
      "then": {
        "properties": {
          "fill_value": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dtype": {
            "const": "bool"
          }
        },
        "required": [
          "dtype"
        ]
      },
      "then": {
        "properties": {
          "fill_value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "axes": {
            "contains": {
              "const": "horizon"
            }
          }
        },
        "required": [
          "axes"
        ]
      },
      "then": {
        "properties": {
          "axes": {
            "contains": {
              "const": "execution"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "DatasetLayout": {
      "type": "object",
      "required": [
        "chunks",
        "filters"
      ],
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Chunk size of each array dimension."
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/Filter"
          },
          "description": "HDF5 filters that the writer applied, in order."
        }
      },
      "description": "HDF5 storage layout of an array. A reader uses it to plan partial reads."
    }
  },
  "description": "One dense array of a model. The tuple entry_type, component_type, and meta identifies it in the model."
}
