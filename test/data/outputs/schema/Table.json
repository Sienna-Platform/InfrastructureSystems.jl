{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "group",
    "length",
    "columns"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "common.json#/$defs/PathName",
      "description": "Table name. It is unique in the model."
    },
    "group": {
      "type": "string",
      "pattern": "^/[^/]+/tables/[^/]+$",
      "description": "HDF5 group path that holds the columns."
    },
    "length": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of rows."
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Column"
      },
      "description": "Columns of the table."
    }
  },
  "$defs": {
    "Column": {
      "type": "object",
      "required": [
        "name",
        "dtype"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Column name. It is unique in the table."
        },
        "dtype": {
          "$ref": "common.json#/$defs/ColumnDtype",
          "description": "Element type of the column."
        },
        "quantity_kind": {
          "$ref": "common.json#/$defs/QuantityKind",
          "description": "Kind of the physical quantity. The name comes from the shared quantity registry."
        },
        "unit_system": {
          "$ref": "common.json#/$defs/UnitSystem",
          "description": "Unit system of the values."
        },
        "base_reference": {
          "$ref": "common.json#/$defs/BaseReference",
          "description": "Base of a COMPONENT_BASE value. It is absent for NATURAL_UNITS."
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "description": "Unit of the values. It is pu for COMPONENT_BASE."
        }
      },
      "dependentRequired": {
        "units": [
          "quantity_kind",
          "unit_system"
        ],
        "quantity_kind": [
          "units",
          "unit_system"
        ],
        "unit_system": [
          "units",
          "quantity_kind"
        ]
      },
      "if": {
        "properties": {
          "unit_system": {
            "const": "COMPONENT_BASE"
          }
        },
        "required": [
          "unit_system"
        ]
      },
      "then": {
        "required": [
          "base_reference"
        ],
        "properties": {
          "units": {
            "const": "pu"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "base_reference"
          ]
        }
      },
      "description": "One column of a table."
    }
  },
  "description": "A set of 1-D columns of the same length, such as optimizer statistics. Each column is one HDF5 dataset."
}
